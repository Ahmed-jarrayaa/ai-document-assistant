# PostgreSQL (used by docker-compose.yml locally)
# On managed hosting (Render...), set POSTGRES_URL to the "Internal Database URL" instead
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_document_assistant

# Embeddings: "auto" (default) -> gemini if GEMINI_API_KEY is set, else hf if HF_TOKEN, else local
# EMBEDDINGS_PROVIDER=local|gemini|hf|auto
EMBEDDINGS_PROVIDER=auto

# --- Gemini embeddings (free tier) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# --- HuggingFace embeddings (paid credits required since 2026) ---
HF_TOKEN=

# --- Ollama (local) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# --- Groq (cloud, OpenAI-compatible) ---
# Get a free API key at https://console.groq.com (API Keys)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-20b

# LLM provider: "ollama" (local server) or "groq" (cloud API)
LLM_PROVIDER=ollama
